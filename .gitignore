# Données d'exécution d'une installation locale (générées au lancement,
# jamais des fichiers source) - voir AppSettings.java, CatalogService.java,
# LanguageService.java, PluginPreferences.java, SelfSignedCertService.java.
# Aucune de ces données n'a sa place dans le dépôt : elles sont propres à
# CHAQUE installation (paramètres, catalogues édités, langues ajoutées,
# certificat HTTPS...), pas au code du projet.

# Réglages de l'application (écran Paramètres)
/app-settings.json
/plugins-config.json

# Catalogues Cartes/Visuels/Fonds/Avatars une fois édités depuis l'écran
# Paramètres (le contenu de départ, lui, reste embarqué dans le jar - voir
# src/main/resources/catalog-seeds/, qui N'EST PAS concerné par cette règle).
/catalogs/

# Langues personnalisées ajoutées après coup (écran Paramètres)
/lang-custom/

# Certificat HTTPS auto-signé (SelfSignedCertService) - la clé privée en
# particulier NE DOIT JAMAIS être commitée.
/tls/

# Sauvegardes temporaires de la base (écran Paramètres, export/import)
/backups-tmp/

# Base de données H2 elle-même (fichiers .mv.db/.trace.db) si générée à la
# racine du projet plutôt que dans un chemin explicite.
*.mv.db
*.trace.db

# Artefacts de build Maven standards.
target/
*.class

# JDK/Maven portables (voir l'en-tête de run.sh/run.bat) - décompressés
# manuellement par un utilisateur à côté de ces scripts sur un poste sans
# droits d'installation, pour ne jamais toucher au Java système en place.
# Des archives volumineuses (~200 Mo chacune), propres à CHAQUE poste,
# jamais des fichiers source du projet.
/jdk-portable/
/maven-portable/

# Autre artefact Maven standard (maven-shade-plugin), généré à côté de
# target/ plutôt que dedans - jamais un fichier source.
dependency-reduced-pom.xml

# Log JPA/Hibernate généré au lancement local du serveur (voir
# geco-server/src/main/resources/logback.xml ou équivalent) - propre à
# chaque exécution, jamais un fichier source. Variantes générées par
# `mvn test` dans chaque module (geco-engine/geco-server) incluses.
gecoJPA.log
gecoJPA-test.log
gecoJPA-server-test.log

# Worktrees Git créés par des agents Claude Code (sous-tâches isolées) -
# infrastructure de session, jamais du contenu du dépôt.
/.claude/worktrees/

# Trouvé et supprimé le 27/09/2026 (seconde relecture indépendante de la
# campagne de test 2/4/10 joueurs) : 1836 fichiers (27 Mo, jsdom/undici et
# leurs dépendances) commités par erreur depuis le commit 486a029 DANS le
# dossier servi publiquement par le serveur web (aucun package.json dans
# tout le dépôt n'en dépend, aucune page HTML/JS ne les charge - confirmé
# avant suppression) - embarqués dans le jar et servis sans authentification
# à qui en devine le chemin, pour un contenu que rien n'utilise jamais.
/geco-server/src/main/resources/public/node_modules/
