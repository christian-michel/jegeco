<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>fr.jytou.geconomicus</groupId>
		<artifactId>geco-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>geco-server</artifactId>
	<packaging>jar</packaging>

	<name>Geconomicus Helper - Server (étape 2/3)</name>
	<description>
		Serveur web local embarqué (Javalin) exposant le moteur métier via une API
		REST + WebSocket, et servant le front HTML/CSS/JS moderne. Base commune pour
		l'étape 2 (UI web pour l'animateur) et l'étape 3 (clients smartphones).
	</description>

	<properties>
		<mainClass>jyt.geconomicus.helper.server.GecoServer</mainClass>
	</properties>

	<dependencies>
		<dependency>
			<groupId>fr.jytou.geconomicus</groupId>
			<artifactId>geco-engine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.eclipse.persistence</groupId>
			<artifactId>org.eclipse.persistence.jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>io.javalin</groupId>
			<artifactId>javalin</artifactId>
		</dependency>
		<!-- HTTPS auto-signé (étape 3, achat de cartes par QR/caméra - nécessite un
		     contexte sécurisé). Plugin officiel Javalin, même version que javalin
		     lui-même (voir ${javalin.version} dans le pom parent). -->
		<dependency>
			<groupId>io.javalin.community.ssl</groupId>
			<artifactId>ssl-plugin</artifactId>
			<version>${javalin.version}</version>
		</dependency>
		<!-- Génération du certificat auto-signé lui-même (voir SelfSignedCertService) -
		     Bouncy Castle plutôt que d'exiger openssl installé sur la machine de
		     l'animateur (Windows/macOS/Linux) : une seule dépendance Java portable. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcpkix-jdk18on</artifactId>
			<version>1.78.1</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>geco-server</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals><goal>shade</goal></goals>
						<configuration>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${mainClass}</mainClass>
								</transformer>
							</transformers>
							<!-- Obligatoire dès qu'une dépendance signée (Bouncy Castle,
							     utilisé par SelfSignedCertService) est fusionnée dans le jar
							     final : sans ça, la JVM refuse de démarrer avec
							     "Invalid signature file digest for Manifest main attributes"
							     (la fusion casse la signature d'origine du jar, le
							     descripteur de signature restant, lui, non modifié - la JVM
							     détecte l'incohérence et bloque tout chargement de classe).
							     Retirer purement et simplement les fichiers de signature du
							     jar fusionné est la solution standard et recommandée pour ce
							     problème avec le plugin Shade. -->
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
