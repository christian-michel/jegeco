<?xml version="1.0" encoding="UTF-8" ?>
<!--
	Configuration de persistance dédiée aux TESTS UNITAIRES de geco-server
	uniquement - même raisonnement que geco-engine/src/test/resources/
	META-INF/persistence.xml (voir ses commentaires pour le détail complet) :
	une unité au nom distinct ("geco-server-test"), pointant vers une base H2
	EN MÉMOIRE (jamais ~/geco.h2), pour que les tests de GameService
	(GameServicePileConservationTest) ne dépendent d'aucune instance de
	l'application déjà lancée et n'écrivent jamais dans les vraies données
	d'un utilisateur.

	Contrairement à l'unité de test de geco-engine (qui ne connaît que
	Game/Player/Event), celle-ci liste aussi Transaction et CardSquareEvent -
	les deux entités supplémentaires que GameService manipule (échanges et
	carrés du mode smartphone, étape 3).
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
	<persistence-unit name="geco-server-test" transaction-type="RESOURCE_LOCAL">
		<class>jyt.geconomicus.helper.Game</class>
		<class>jyt.geconomicus.helper.Player</class>
		<class>jyt.geconomicus.helper.Event</class>
		<class>jyt.geconomicus.helper.EventTypeConverter</class>
		<class>jyt.geconomicus.helper.Transaction</class>
		<class>jyt.geconomicus.helper.CardSquareEvent</class>
		<properties>
			<property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver" />
			<!-- Base en mémoire, isolée, jetable - nom distinct de celle de
			     geco-engine (geco_test) pour éviter toute ambiguïté si les deux
			     venaient à tourner dans la même JVM. -->
			<property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:geco_server_test;DB_CLOSE_DELAY=-1" />
			<property name="jakarta.persistence.jdbc.user" value="sa" />
			<property name="jakarta.persistence.jdbc.password" value="" />
			<property name="eclipselink.ddl-generation" value="create-or-extend-tables" />
			<property name="eclipselink.ddl-generation.output-mode" value="database" />
			<property name="eclipselink.logging.file" value="gecoJPA-server-test.log" />
			<property name="eclipselink.allow-zero-id" value="true" />
		</properties>
	</persistence-unit>
</persistence>
